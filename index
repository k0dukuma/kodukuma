<!doctype html>
<html lang="et">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Kodukuma</title>
  <meta name="description" content="Kodukuma koduleht on valmimisel.">
  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      min-height: 100svh;
      display: grid;
      place-items: center;
      background: #b5c288;
      color: white;
      text-align: center;
      font-family: Arial, sans-serif;
    }

    main { padding: 32px; }

    h1 {
      margin: 0;
      font-size: clamp(3.5rem, 12vw, 8rem);
      font-weight: 700;
      letter-spacing: .08em;
      line-height: 1;
    }

    p {
      margin: 24px 0 0;
      font-family: Georgia, serif;
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      font-style: italic;
    }
  </style>
</head>
<body>
  <main>
    <h1>KODUKUMA</h1>
    <p>koduleht valmimisel ♡</p>
  </main>
</body>
</html>
